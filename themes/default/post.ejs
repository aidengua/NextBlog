<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= config.title || '我的日記' %></title>
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap">
</head>
<body>
  <div class="container">
    <header class="site-header">
      <h1 class="site-title"><a href="/"><%= config.title || '我的日記' %></a></h1>
    </header>

    <main class="content">
      <article class="post">
        <header class="post-header">
          <h1 class="post-title"><%= title %></h1>
          <div class="post-meta">
            <time datetime="<%= date %>"><%= new Date(date).toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
          </div>
        </header>
        <div class="post-content">
          <%- content %>
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <a href="/" class="back-home">← 返回首頁</a>
      <p>&copy; <%= new Date().getFullYear() %> <%= config.author || '作者' %>. 保留所有權利。</p>
    </footer>
  </div>
</body>
</html>
